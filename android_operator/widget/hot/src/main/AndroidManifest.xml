<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exportado porque lo exige el sistema para los widgets (APPWIDGET_UPDATE es un broadcast protegido). -->
        <receiver
            android:name=".HotSalesWidgetReceiver"
            android:exported="true"
            android:label="@string/hot_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hot_sales_widget" />
        </receiver>
    </application>
</manifest>
