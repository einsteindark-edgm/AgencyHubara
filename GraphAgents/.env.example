# Copiá a .env y completá lo que necesites. El hola mundo (LocalRuntime) NO
# requiere ninguna de estas; sí las necesitás para el runtime real de AgentSpan.

# ---------- Stack (docker-compose) ----------
AGENTSPAN_IMAGE=agentspan/server:latest
POSTGRES_IMAGE=postgres:16-alpine
AGENTSPAN_PORT=6767
POSTGRES_DB=agentspan
POSTGRES_USER=agentspan
POSTGRES_PASSWORD=changeme

# Master key para cifrar credenciales en AgentSpan (base64 de 32 bytes).
# Generar: openssl rand -base64 32
AGENTSPAN_MASTER_KEY=

# ---------- Runtime de nuestra app ----------
AGENTSPAN_SERVER_URL=http://localhost:6767
GRAPHAGENTS_RUNTIME=local   # local (hola mundo) | agentspan (runtime real, G1+)

# ---------- LLM para las capabilities (al menos uno para el runtime real) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Meta Marketing API — ConnectorKit (vendor live) ----------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---------- Publicar desde el explorer (commit + push + PR) ----------
# En local: GH_TOKEN=$(gh auth token) docker compose up  — o pegá acá un token.
# Sin token el explorer anda igual (el botón publicar degrada con error legible).
GH_TOKEN=
GIT_AUTHOR_NAME=hubara-explorer
GIT_AUTHOR_EMAIL=explorer@hubara.local
