# ── Hubara Agent Gateway — variables (copiar a .env; .env NUNCA se commitea) ──
# Identificador canónico del recurso MCP = lo que el cliente pide como `resource`
# (RFC 8707) y lo que Cognito pone en `aud`. https:// o http://localhost.
GATEWAY_RESOURCE_URL=http://localhost:8765/mcp
# Hosts aceptados (DNS rebinding). Por defecto: el host:puerto de GATEWAY_RESOURCE_URL.
GATEWAY_ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765
# Origins de navegador aceptados (vacío = solo clientes sin Origin, como Node/DSH).
GATEWAY_ALLOWED_ORIGINS=

# ── Cognito (entrada: tokens del usuario vía app client dsh-hubara) ──
COGNITO_REGION=us-east-1
# Output Terraform `user_pool_id` del tenant (infra/terraform/platform).
COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
# Output Terraform `dsh_hubara_client_id` (módulo auth). Coma-separado.
GATEWAY_ALLOWED_CLIENT_IDS=
GATEWAY_READ_SCOPE=hubara-mcp/ads.read
GATEWAY_PII_SCOPE=hubara-mcp/ads.pii
GATEWAY_PII_GROUP=admin
GATEWAY_REQUIRE_AUDIENCE=true

# ── Backend real (salida: token M2M PROPIO, nunca el del usuario) ──
# El `domain` del tenant en infra/terraform/compute/tenants.auto.tfvars (https://<domain>).
BACKEND_URL=https://api.example.test
COGNITO_DOMAIN=agencyhubara-hubara.auth.us-east-1.amazoncognito.com
# Output Terraform `agent_gateway_client_id`; el secreto sale de SSM (ver README).
BACKEND_M2M_CLIENT_ID=
BACKEND_M2M_CLIENT_SECRET=
BACKEND_M2M_SCOPE=hubara-api/ads.read

# ── Límites ──
GATEWAY_MAX_BODY_BYTES=65536
GATEWAY_RATE_LIMIT_PER_MINUTE=120
BACKEND_TIMEOUT_S=20
BACKEND_MAX_RESPONSE_BYTES=8388608
LOG_LEVEL=INFO
