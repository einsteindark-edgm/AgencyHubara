# Backend API base URL (FastAPI dispatcher en hubara_agency).
VITE_API_URL=http://localhost:8000

# OTel web tracing (F6.6): opt-in en dev, on por default en build prod.
# VITE_OTEL_ENABLED=1            # forzar tracing en dev (requiere collector :4318)
# VITE_OTEL_EXPORTER_URL=http://localhost:4318/v1/traces
# VITE_OTEL_SAMPLE_RATE=1        # 0..1 — muestreo de traces en prod
