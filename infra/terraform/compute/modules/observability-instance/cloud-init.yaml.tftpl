#cloud-config
# Prep base de la caja SigNoz. El deploy del stack (vendorizado en
# hubara_agency/deploy/signoz/) lo hace observability-deploy.yml.
package_update: true
packages:
  - docker

runcmd:
  - mkdir -p /usr/libexec/docker/cli-plugins
  - curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 -o /usr/libexec/docker/cli-plugins/docker-compose
  - chmod +x /usr/libexec/docker/cli-plugins/docker-compose
  - systemctl enable --now docker
  - usermod -aG docker ec2-user
  - mkdir -p /opt/signoz
  - chown -R ec2-user:ec2-user /opt/signoz
