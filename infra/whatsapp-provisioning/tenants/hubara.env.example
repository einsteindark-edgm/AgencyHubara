# Config declarativa del tenant (estado deseado) para whatsapp_provision.py.
# Copiá a `hubara.env` (gitignoreá los reales) y completá. NO pongas secretos
# (token / app secret) acá si podés evitarlo — pasalos por env:
#   export META_SYSTEM_USER_TOKEN=EAA...   export WHATSAPP_APP_SECRET=...
#
# Valores Hubara descubiertos por API el 2026-06-30 (business Lily Pulido).

TENANT=hubara
BUSINESS_ID=1873134773439557          # Lily Pulido
APP_ID=36625019197144622              # App "Hubara"
WABA_ID=3018148735027036             # WABA "Hubara" (APPROVED)
CATALOG_ID=868785339159351           # "Catálogo_productos_chatbot"

# Webhook (apunta al API de prod detrás de Caddy; CADDY_DOMAIN del box).
CALLBACK_URL=https://98-88-237-207.sslip.io/api/chats/webhook
VERIFY_TOKEN=my_verify_token

# Número NUEVO a dar de alta (E.164 partido en cc + resto, sin '+').
# Dejalos vacíos hasta tener la línea. Si lo agregaste por la UI de WhatsApp
# Manager, en vez de cc/number poné PHONE_NUMBER_ID=<id> y saltá el add-number.
NEW_NUMBER_CC=57
NEW_NUMBER=
DISPLAY_NAME=Hubara
CODE_METHOD=SMS                       # SMS | VOICE
LANGUAGE=es_ES
PIN=                                  # PIN 2FA de 6 dígitos (default 123456 si vacío)

# Secretos — MEJOR por env, no acá:
# SYSTEM_USER_TOKEN=
# APP_SECRET=
API_VERSION=v23.0
