# Plantilla de secretos para `aws_bootstrap.py secrets`. Copiá a
# `secrets.<tenant>.env` (ej. secrets.hubara.env), poné los valores REALES, y
# corré:  python3 aws_bootstrap.py secrets --tenant hubara --file secrets.hubara.env
#
# `secrets.<tenant>.env` está gitignoreado — NUNCA se commitea con valores reales.
# Estos placeholders sirven tal cual para PROBAR contra robotocore (--endpoint-url).
#
# Las claves espejan platform/variables.tf:secret_keys. De dónde sale cada una:
#   - DEEPSEEK/GEMINI: las API keys del LLM (mismas que hoy en tu .env local).
#   - WHATSAPP_*: Meta WhatsApp Cloud API (phone number id + tokens).
#   - MEDUSA_*: tu instancia Medusa (base url + admin token).
#   - META_*: Commerce Catalog (catalog id + system user token).
#   - TEMPORAL_*: salen del setup de Temporal Cloud (ver DEPLOY_RUNBOOK §pendientes).
#   - GHCR_PULL_TOKEN: PAT de GitHub con `read:packages` (para que la caja baje la imagen).

DEEPSEEK_API_KEY=sk-PLACEHOLDER
GEMINI_API_KEY=AIza-PLACEHOLDER
WHATSAPP_PHONE_NUMBER_ID=PLACEHOLDER
WHATSAPP_ACCESS_TOKEN=PLACEHOLDER
WHATSAPP_VERIFY_TOKEN=my_verify_token
MEDUSA_BASE_URL=https://medusa.example
MEDUSA_ADMIN_TOKEN=sk_PLACEHOLDER
META_CATALOG_ID=000000000000000
META_SYSTEM_USER_TOKEN=EAA_PLACEHOLDER
TEMPORAL_ADDRESS=us-east-1.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=hubara.xxxxx
TEMPORAL_API_KEY=PLACEHOLDER
GHCR_PULL_TOKEN=ghp_PLACEHOLDER
