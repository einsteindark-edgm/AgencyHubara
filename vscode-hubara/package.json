{
  "name": "hubara-studio",
  "displayName": "Hubara Studio",
  "description": "Grafos, certificaciones y ejecuciones de AgencyHubara + GraphAgents dentro de VS Code.",
  "version": "0.0.1",
  "publisher": "hubara",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/einsteindark-edgm/AgencyHubara.git",
    "directory": "vscode-hubara"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Testing",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "hubara.openStudio",
        "title": "Hubara: Open Graph",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.openGraphAgents",
        "title": "Hubara: Open GraphAgents Graph",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.openSystemMap",
        "title": "Hubara: Open System Map",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.restartBridges",
        "title": "Hubara: Restart Python Bridges",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.refreshGraphs",
        "title": "Hubara: Refresh Graphs",
        "category": "Hubara Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "hubara.focusNode",
        "title": "Hubara: Ver en grafo",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.selectPlan",
        "title": "Hubara: Select & Run Test Plan…",
        "category": "Hubara Studio",
        "icon": "$(beaker)"
      },
      {
        "command": "hubara.runActivePlan",
        "title": "Hubara: Run Active Test Plan",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.checkManifest",
        "title": "Hubara: Check Manifests",
        "category": "Hubara Studio",
        "icon": "$(check)"
      },
      {
        "command": "hubara.refreshRuns",
        "title": "Hubara: Refresh Runs",
        "category": "Hubara Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "hubara.viewTrace",
        "title": "Hubara: Ver trace",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.replayCase",
        "title": "▶ Replay",
        "category": "Hubara Studio",
        "icon": "$(play)"
      },
      {
        "command": "hubara.runDurableCase",
        "title": "▶ Run Durable (AgentSpan)",
        "category": "Hubara Studio",
        "icon": "$(debug-start)"
      },
      {
        "command": "hubara.connectFromPicker",
        "title": "+ Conectar desde…",
        "category": "Hubara Studio",
        "icon": "$(plug)"
      },
      {
        "command": "hubara.saveProduction",
        "title": "Hubara: Save Production (GraphAgents)",
        "category": "Hubara Studio"
      },
      {
        "command": "hubara.publishProduction",
        "title": "Hubara: Publish Production (GraphAgents)",
        "category": "Hubara Studio"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hubaraStudio",
          "title": "Hubara Studio",
          "icon": "$(type-hierarchy-sub)"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "hubaraStudio.gettingStarted",
        "title": "Hubara Studio: primeros pasos",
        "description": "Grafos, certificaciones y ejecuciones de AgencyHubara + GraphAgents — todo sin salir de VS Code.",
        "steps": [
          {
            "id": "scopes",
            "title": "Abrí el grafo — scopes estilo Xcode",
            "description": "Workspace / System / Focus — el equivalente project/target aplicado al canvas.\n[Abrir grafo](command:hubara.openStudio)",
            "media": { "markdown": "walkthrough/scopes.md" },
            "completionEvents": ["onCommand:hubara.openStudio"]
          },
          {
            "id": "testPlans",
            "title": "Corré un test plan — bundles estilo Xcode",
            "description": "Las mismas suites que `/hubara-gates`, agrupadas en bundles seleccionables.\n[Elegir un plan](command:hubara.selectPlan)",
            "media": { "markdown": "walkthrough/test-plans.md" },
            "completionEvents": ["onCommand:hubara.selectPlan", "onCommand:hubara.runActivePlan"]
          },
          {
            "id": "certifications",
            "title": "Certificaciones — el compilador en el editor",
            "description": "Badges C0–C3, CodeLens, Problems panel — todo desde guardar un manifest.\n[Ver el catálogo](command:workbench.view.extension.hubaraStudio)",
            "media": { "markdown": "walkthrough/certifications.md" },
            "completionEvents": ["onView:hubara.catalogTree"]
          },
          {
            "id": "editMode",
            "title": "Edit mode — conectar sin salir del IDE",
            "description": "Drag-connect, disconnect, y publicar el wiring con un PR real.",
            "media": { "markdown": "walkthrough/edit-mode.md" }
          }
        ]
      }
    ],
    "views": {
      "hubaraStudio": [
        {
          "id": "hubara.catalogTree",
          "name": "Catálogo",
          "icon": "$(type-hierarchy-sub)"
        },
        {
          "id": "hubara.runsTree",
          "name": "Runs",
          "icon": "$(pulse)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "hubara.focusNode",
          "when": "false"
        },
        {
          "command": "hubara.checkManifest",
          "when": "false"
        },
        {
          "command": "hubara.viewTrace",
          "when": "false"
        },
        {
          "command": "hubara.replayCase",
          "when": "false"
        },
        {
          "command": "hubara.runDurableCase",
          "when": "false"
        },
        {
          "command": "hubara.connectFromPicker",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "hubara.refreshGraphs",
          "when": "view == hubara.catalogTree",
          "group": "navigation"
        },
        {
          "command": "hubara.refreshRuns",
          "when": "view == hubara.runsTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "hubara.replayCase",
          "when": "view == hubara.catalogTree && viewItem == hubaraCase",
          "group": "inline@1"
        },
        {
          "command": "hubara.runDurableCase",
          "when": "view == hubara.catalogTree && viewItem == hubaraCase",
          "group": "inline@2"
        },
        {
          "command": "hubara.connectFromPicker",
          "when": "view == hubara.catalogTree && viewItem == hubaraConnectable",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Hubara Studio",
      "properties": {
        "hubara.graphagents.python": {
          "type": "string",
          "default": "python3",
          "markdownDescription": "Ejecutable de Python para el puente de GraphAgents (subsistema aislado, NO usa `uv`)."
        },
        "hubara.graphagents.cwd": {
          "type": "string",
          "default": "${workspaceFolder}/GraphAgents",
          "description": "Directorio raíz de GraphAgents (donde vive `viewer/bridge.py`)."
        },
        "hubara.backend.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "uv",
            "run",
            "python"
          ],
          "markdownDescription": "Comando + args para correr Python en el backend Hubara (por convención `uv run python`)."
        },
        "hubara.backend.cwd": {
          "type": "string",
          "default": "${workspaceFolder}/hubara_agency",
          "description": "Directorio raíz del backend (donde vive `scripts/system_map_bridge.py`)."
        },
        "hubara.frontend.cwd": {
          "type": "string",
          "default": "${workspaceFolder}/frontend_dashboard",
          "description": "Directorio raíz del dashboard React/TS."
        },
        "hubara.frontend.npm": {
          "type": "string",
          "default": "npm",
          "description": "Ejecutable de npm para las suites del frontend."
        },
        "hubara.frontend.npx": {
          "type": "string",
          "default": "npx",
          "description": "Ejecutable de npx (usado por la suite de tipos: `tsc -b --noEmit`)."
        },
        "hubara.seamsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Ruta a `seams.yaml` (costuras cross-sistema del canvas workspace). Vacío = usa `<repoRoot>/seams.yaml` si existe, o el archivo bundled con la extensión."
        },
        "hubara.backend.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "MEDUSA_BASE_URL": "http://localhost:9000",
            "MEDUSA_ADMIN_TOKEN": "dev-token"
          },
          "markdownDescription": "Env vars dummy que las suites de arquitectura del backend necesitan a nivel de import (`MEDUSA_*` — el sales worker construye clientes Medusa a nivel de módulo). Nunca pega a Medusa real."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0"
  }
}
