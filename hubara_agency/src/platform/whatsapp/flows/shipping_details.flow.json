{
  "version": "5.0",
  "data_api_version": "3.0",
  "routing_model": {
    "SHIPPING_DETAILS": ["CONFIRM"],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "SHIPPING_DETAILS",
      "title": "Datos de envío",
      "terminal": false,
      "data": {
        "cities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "bogota", "title": "Bogotá" },
            { "id": "medellin", "title": "Medellín" },
            { "id": "cali", "title": "Cali" },
            { "id": "barranquilla", "title": "Barranquilla" },
            { "id": "cartagena", "title": "Cartagena" }
          ]
        },
        "show_cash_on_delivery": {
          "type": "boolean",
          "__example__": true
        },
        "items_summary": {
          "type": "string",
          "__example__": "2× Vela Cruz de Vida"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Tus datos de envío"
          },
          {
            "type": "TextBody",
            "text": "Toma 30 segundos. Confirmamos tu pedido apenas termines."
          },
          {
            "type": "TextCaption",
            "text": "${data.items_summary}"
          },
          {
            "type": "Dropdown",
            "label": "Ciudad",
            "name": "ciudad",
            "required": true,
            "data-source": "${data.cities}"
          },
          {
            "type": "TextInput",
            "label": "Barrio o sector",
            "name": "barrio",
            "required": true,
            "input-type": "text",
            "min-chars": 2,
            "max-chars": 60,
            "helper-text": "Ej: Chapinero, El Poblado"
          },
          {
            "type": "TextInput",
            "label": "Dirección completa",
            "name": "direccion",
            "required": true,
            "input-type": "text",
            "min-chars": 5,
            "max-chars": 200,
            "helper-text": "Calle / carrera + número. Apto si aplica."
          },
          {
            "type": "TextInput",
            "label": "Teléfono de contacto",
            "name": "telefono",
            "required": true,
            "input-type": "phone",
            "min-chars": 10,
            "max-chars": 15,
            "helper-text": "Para coordinar entrega. Si es el mismo del chat, escribelo igual."
          },
          {
            "type": "TextInput",
            "label": "Indicaciones para el repartidor (opcional)",
            "name": "indicaciones",
            "required": false,
            "input-type": "text",
            "max-chars": 200,
            "helper-text": "Ej: portería principal, llamar al llegar"
          },
          {
            "type": "RadioButtonsGroup",
            "label": "Método de pago",
            "name": "pago",
            "required": true,
            "data-source": [
              { "id": "transfer", "title": "Transferencia (Nequi/Bancolombia)" },
              { "id": "card", "title": "Tarjeta crédito/débito" },
              { "id": "cash_on_delivery", "title": "Contra entrega (efectivo)", "enabled": "${data.show_cash_on_delivery}" }
            ]
          },
          {
            "type": "Footer",
            "label": "Confirmar pedido",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "ciudad": "${form.ciudad}",
                "barrio": "${form.barrio}",
                "direccion": "${form.direccion}",
                "telefono": "${form.telefono}",
                "indicaciones": "${form.indicaciones}",
                "pago": "${form.pago}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Pedido confirmado",
      "terminal": true,
      "success": true,
      "data": {
        "summary_text": {
          "type": "string",
          "__example__": "Tu pedido se está procesando. Te confirmamos por chat."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "¡Listo!"
          },
          {
            "type": "TextBody",
            "text": "${data.summary_text}"
          },
          {
            "type": "Footer",
            "label": "Volver al chat",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
