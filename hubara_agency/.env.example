# Hubara Agency — environment variables
# Copia este archivo a `.env` y rellena con valores reales.
# `.env` está en .gitignore — NUNCA commitear secrets reales.

# ----- LLM / LiteLLM proxy -----
DEEPSEEK_API_KEY=sk-PLACEHOLDER_REPLACE_ME
GEMINI_API_KEY=AIza-PLACEHOLDER_REPLACE_ME
API_BASE_LLMLITE=http://localhost:4000

# ----- WhatsApp Cloud API -----
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token
WHATSAPP_ACCESS_TOKEN=PLACEHOLDER_REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=PLACEHOLDER

# ----- Temporal -----
TEMPORAL_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=

# ----- Workspaces per-agent -----
# Default: <repo>/hubara_agency/src/<agent>/workspace/. Override en prod.
EXOCLAW_WORKSPACE_SALES=
EXOCLAW_WORKSPACE_REMARKETING=
WORKSPACE_VAULT_DIR=./hubara_vault

# ----- Medusa Admin API (HU-01) -----
# Crear el Secret API Key en https://<medusa>/app → Settings → Developer → Secret API Keys
MEDUSA_BASE_URL=http://localhost:9000
MEDUSA_ADMIN_TOKEN=sk_local_PLACEHOLDER_REPLACE_ME

# ----- Catalog snapshot (HU-02 + HU-03) -----
# DEV: default = <repo>/hubara_agency/catalog_workspace
# PROD: monta EFS PVC en /var/lib/hubara/catalog
CATALOG_SNAPSHOT_DIR=
CATALOG_MAX_AGE_MINUTES=30
