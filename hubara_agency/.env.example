# Hubara Agency — environment variables
# Copia este archivo a `.env` y rellena con valores reales.
# `.env` está en .gitignore — NUNCA commitear secrets reales.

# ----- LLM / LiteLLM proxy -----
DEEPSEEK_API_KEY=sk-PLACEHOLDER_REPLACE_ME
GEMINI_API_KEY=AIza-PLACEHOLDER_REPLACE_ME
API_BASE_LLMLITE=http://localhost:4000

# ----- WhatsApp Cloud API -----
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token
WHATSAPP_ACCESS_TOKEN=PLACEHOLDER_REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=PLACEHOLDER

# ----- Temporal -----
TEMPORAL_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=

# ----- Workspaces per-agent -----
# Default: <repo>/hubara_agency/src/<agent>/workspace/. Override en prod.
EXOCLAW_WORKSPACE_SALES=
EXOCLAW_WORKSPACE_REMARKETING=
WORKSPACE_VAULT_DIR=./hubara_vault

# ----- Medusa Admin API (HU-01) -----
# Crear el Secret API Key en https://<medusa>/app → Settings → Developer → Secret API Keys
MEDUSA_BASE_URL=http://localhost:9000
MEDUSA_ADMIN_TOKEN=sk_local_PLACEHOLDER_REPLACE_ME

# ----- Catalog snapshot (HU-02 + HU-03) -----
# DEV: default = <repo>/hubara_agency/catalog_workspace
# PROD: monta EFS PVC en /var/lib/hubara/catalog
CATALOG_SNAPSHOT_DIR=
CATALOG_MAX_AGE_MINUTES=30

# ----- Meta Commerce Catalog (HU-002 Parte B) -----
# Ver hubara_agency/docs/META_CATALOG_SETUP.md para cómo obtenerlos en
# Business Manager / Commerce Manager. Sin estos, push_meta_catalog_activity
# loguea warning y skipea (no rompe el sync — solo no propaga a Meta).
#
# META_CATALOG_ID: numérico ~16 dígitos, visible en la URL de Commerce
#   Manager (commerce.facebook.com/commerce/<ID>/home).
# META_SYSTEM_USER_TOKEN: token permanente del System User con scopes
#   catalog_management + whatsapp_business_management. Empieza con `EAA…`,
#   ~200 chars. NUNCA committeado. Generar en business.facebook.com →
#   Business Settings → Users → System Users → Generate Token (Never expires).
META_CATALOG_ID=
META_SYSTEM_USER_TOKEN=

# Opcionales — solo para auditoría / future multi-tenant. La activity no los lee.
META_BUSINESS_ID=
META_WABA_ID=

# ----- WhatsApp Flow de datos de envío (HU-002 Parte A.9) -----
# Ver hubara_agency/docs/META_CATALOG_SETUP.md §Fase 13 para crear el Flow
# en Meta Flow Builder a partir de docs/whatsapp_flows/shipping_v1.json.
#
# Si está vacío → el agente cae a recolección conversacional turn-by-turn
# (manda un mensaje de texto enumerando los 5 campos). Cuando se setea con
# un flow_id real PUBLICADO, el agente abre el formulario nativo Meta y
# recibe los datos vía `nfm_reply`.
#
# Formato esperado: string numérico ~16 dígitos, devuelto por Meta cuando
# se publica el Flow (Flow Builder → Publish → "Flow ID: 1234567890123456").
META_FLOW_ID_SHIPPING=
