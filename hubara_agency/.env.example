# Hubara Agency — environment variables
# Copia este archivo a `.env` y rellena con valores reales.
# `.env` está en .gitignore — NUNCA commitear secrets reales.

# ----- LLM / LiteLLM proxy -----
DEEPSEEK_API_KEY=sk-PLACEHOLDER_REPLACE_ME
GEMINI_API_KEY=AIza-PLACEHOLDER_REPLACE_ME
API_BASE_LLMLITE=http://localhost:4000

# ----- WhatsApp Cloud API -----
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token
WHATSAPP_ACCESS_TOKEN=PLACEHOLDER_REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=PLACEHOLDER

# ----- Temporal -----
TEMPORAL_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=

# ----- Workspaces per-agent -----
# Default: <repo>/hubara_agency/src/<agent>/workspace/. Override en prod.
EXOCLAW_WORKSPACE_SALES=
EXOCLAW_WORKSPACE_REMARKETING=
WORKSPACE_VAULT_DIR=./hubara_vault

# ----- Medusa Admin API (HU-01) -----
# Crear el Secret API Key en https://<medusa>/app → Settings → Developer → Secret API Keys
MEDUSA_BASE_URL=http://localhost:9000
MEDUSA_ADMIN_TOKEN=sk_local_PLACEHOLDER_REPLACE_ME

# ----- Medusa Order Registration (sesión c4e3416f) -----
# `RegisterOrderTool` crea Draft Orders en Medusa al cierre exitoso de venta.
# Sin estos vars el composition cae al `StubOrderRegistration` (loguea WARNING
# y no escribe en Medusa — útil en dev, NO en prod).
#
# Cómo obtenerlos en Medusa Admin (http://localhost:9000/app):
#   MEDUSA_REGION_ID:
#     Settings → Regions → pick/create "Colombia / COP" → copia el ID
#     (formato `reg_01HXX...`).
#   MEDUSA_SALES_CHANNEL_ID:
#     Settings → Sales Channels → pick "Default" (o crear "WhatsApp Hubara") →
#     copia el ID (formato `sc_01HXX...`).
#   MEDUSA_DEFAULT_SHIPPING_OPTION_ID (opcional, recomendado):
#     Settings → Locations & Shipping → pick el shipping profile → pick una
#     option → copia el ID (formato `so_01HXX...`). Si lo dejás vacío, el
#     adapter lo descubre con `GET /admin/shipping-options?region_id=...` y
#     usa el primero — funciona, pero añade un round-trip por checkout.
#
# `MEDUSA_DEFAULT_CURRENCY` / `MEDUSA_DEFAULT_COUNTRY` son lowercase per spec
# de Medusa v2 ("cop", "co"). Cambiarlos solo si servís otro país.
MEDUSA_REGION_ID=
MEDUSA_SALES_CHANNEL_ID=
MEDUSA_DEFAULT_SHIPPING_OPTION_ID=
MEDUSA_DEFAULT_CURRENCY=cop
MEDUSA_DEFAULT_COUNTRY=co

# ----- Catalog snapshot (HU-02 + HU-03) -----
# DEV: default = <repo>/hubara_agency/catalog_workspace
# PROD: monta EFS PVC en /var/lib/hubara/catalog
CATALOG_SNAPSHOT_DIR=
CATALOG_MAX_AGE_MINUTES=30

# ----- Meta Commerce Catalog (HU-002 Parte B) -----
# Ver hubara_agency/docs/META_CATALOG_SETUP.md para cómo obtenerlos en
# Business Manager / Commerce Manager. Sin estos, push_meta_catalog_activity
# loguea warning y skipea (no rompe el sync — solo no propaga a Meta).
#
# META_CATALOG_ID: numérico ~16 dígitos, visible en la URL de Commerce
#   Manager (commerce.facebook.com/commerce/<ID>/home).
# META_SYSTEM_USER_TOKEN: token permanente del System User con scopes
#   catalog_management + whatsapp_business_management. Empieza con `EAA…`,
#   ~200 chars. NUNCA committeado. Generar en business.facebook.com →
#   Business Settings → Users → System Users → Generate Token (Never expires).
META_CATALOG_ID=
META_SYSTEM_USER_TOKEN=

# Opcionales — solo para auditoría / future multi-tenant. La activity no los lee.
META_BUSINESS_ID=
META_WABA_ID=

# ----- WhatsApp Flow de datos de envío (HU-002 Parte A.9) -----
# Ver hubara_agency/docs/META_CATALOG_SETUP.md §Fase 13 para crear el Flow
# en Meta Flow Builder a partir de docs/whatsapp_flows/shipping_v1.json.
#
# Si está vacío → el agente cae a recolección conversacional turn-by-turn
# (manda un mensaje de texto enumerando los 5 campos). Cuando se setea con
# un flow_id real PUBLICADO, el agente abre el formulario nativo Meta y
# recibe los datos vía `nfm_reply`.
#
# Formato esperado: string numérico ~16 dígitos, devuelto por Meta cuando
# se publica el Flow (Flow Builder → Publish → "Flow ID: 1234567890123456").
META_FLOW_ID_SHIPPING=

# =====================================================================
# Schedulers — CUÁNDO corren los jobs periódicos
# =====================================================================
# En producción (EKS) estos viven en el ConfigMap `hubara-scheduler-config`
# (k8s/aws-produccion/scheduler-config-configmap.yaml) y se cambian SIN
# redeploy: editar el ConfigMap + `kubectl rollout restart` del worker. Acá
# se documentan los defaults (los workers caen a ellos si la var no está).
#
# Los 3 Schedules de Temporal CONVERGEN su spec al valor de estas vars al
# rebootear el worker (no solo en la primera creación).

# orders/reconcile — barrido de órdenes pendientes (intervalo, minutos).
ORDER_RECONCILE_INTERVAL_MINUTES=5

# sales-eval ONLINE — eval de conversaciones reales (cron, tz America/Bogota).
# ENABLED=false BORRA el schedule (la eval queda event-driven al cerrar episodio).
SALES_EVAL_SCHEDULE_ENABLED=true
SALES_EVAL_SCHEDULE_CRON=0 23 * * *

# golden-eval — set controlado (cron, tz America/Bogota). OPT-IN: el golden
# vive en el GitHub Action; ENABLED=true lo agenda también en este worker.
GOLDEN_EVAL_SCHEDULE_ENABLED=false
GOLDEN_EVAL_SCHEDULE_CRON=0 6 * * *

# remarketing-watchdog — nudge antes de cerrar la ventana 24h de WhatsApp.
# NO es un Schedule (workflow per-episodio); el lead time se lee por episodio.
WATCHDOG_ENABLED=false
# Minutos ANTES del cierre de ventana en que dispara el nudge (default 30).
WATCHDOG_PRE_EXPIRY_MINUTES=30
# Horario local permitido para disparar (evita sends nocturnos). Allowed [START,END).
WATCHDOG_QUIET_HOURS_START=8
WATCHDOG_QUIET_HOURS_END=22
