; import-linter contracts — DEHA architectural rules (R-DIP, isolation, anti-patterns).
;
; Run from hubara_agency/:  uv run lint-imports
; Also invoked from tests/architecture/test_r_dip.py as part of `pytest -m architecture`.
;
; Rule index ↔ contract:
;   R-DIP #7  → forbidden: tools should not import temporal client/worker
;   R-DIP #8  → forbidden: parsers must stay pure (no I/O libs)
;   R-DIP #9  → independence: platform must not depend on any agent
;   R-DIP #10 → independence: agents must not import each other (cross-agent via platform/)
;
; PR2/PR5 — refactor a plugins/. Las antiguas raíces `src.sales_whatsapp`,
; `src.remarketing_whatsapp`, `src.dashboard` y `src.catalog_sync` desaparecieron. Hoy:
;   - sales agente   → `src.plugins.chats.agent.sales`
;   - remarketing    → `src.plugins.chats.agent.remarketing`
;   - dashboard HTTP → `src.plugins.chats.api.{dashboard,handoff,dashboard_composition}`
;   - catalog        → `src.plugins.catalog.agent` (worker en `src.plugins.catalog.workers.sync`)
;
; Notes:
;   - `plugins/<id>/api/` (FastAPI HTTP edge) está intencionalmente FUERA del scope
;     R-DIP — los routers son adapters, no DEHA.
;   - Cada contracto es independiente; una violación no silencia las demás.

[importlinter]
root_packages =
    src
include_external_packages = True

; --- R-DIP #9 — platform/ owns no agent dependency ----------------------------
[importlinter:contract:platform-no-agents]
name = R-DIP: src.platform must not import any agent package
type = forbidden
source_modules =
    src.platform
forbidden_modules =
    src.plugins.chats.agent.sales
    src.plugins.chats.agent.remarketing
    src.plugins.catalog.agent
; Agent code is composed on top of platform; reversing the arrow couples them.
;
; Known debt — documented exceptions (do NOT add more without ADR):
;   - dispatcher.py uses LOCAL imports inside @activity.defn bodies to avoid
;     cycles when dispatching to a sibling agent. Long-term fix: move
;     SalesSessionInput / RemarketingSessionInput / workflow registry to
;     src/platform/* and dispatch by workflow name + DTO without importing
;     agent modules.
ignore_imports =
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.sales.config.env
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.sales.contracts
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.sales.workflows.sales_session
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.remarketing.config.env
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.remarketing.contracts
unmatched_ignore_imports_alerting = warn
; Some local-import edges only appear when the activity body is executed.
; "warn" prevents CI failure when an exception goes unused, but still surfaces it.

; --- R-DIP #10 — agent siblings stay isolated ---------------------------------
[importlinter:contract:agents-independent]
name = R-DIP: agent packages must be independent of each other
type = independence
modules =
    src.plugins.chats.agent.sales
    src.plugins.chats.agent.remarketing
    src.plugins.catalog.agent
; Cross-agent flow goes through src.platform.* (dispatcher, contracts, channels).
; If you need shared code, lift it to src.platform/ — never import a sibling agent.
;
; Known debt — documented exceptions (do NOT add more without ADR):
;
;   1. The dispatcher activity (src.platform.temporal.dispatcher) uses LOCAL
;      imports inside @activity.defn bodies to avoid module-level cycles when
;      routing to a sibling agent. Long-term fix: move SessionInput DTOs +
;      workspace-path lookups to src.platform.contracts / src.platform.config,
;      dispatch by workflow name string + DTO without importing agent modules.
;
;   2. sales.use_cases.load_or_start_sales_session imports
;      RemarketingSessionWorkflow as a TYPE for `workflow_class: type` so it
;      can call `start_workflow(<class>, ...)`. Long-term fix: same as #1 —
;      when workflow registry lives in platform/, the use-case branches on a
;      string key and the cross-agent import disappears.
ignore_imports =
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.sales.config.env
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.sales.contracts
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.sales.workflows.sales_session
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.remarketing.config.env
    src.platform.temporal.dispatcher -> src.plugins.chats.agent.remarketing.contracts
    src.plugins.chats.agent.sales.use_cases.load_or_start_sales_session -> src.plugins.chats.agent.remarketing.workflows.remarketing
unmatched_ignore_imports_alerting = warn

; --- R-DIP #7 — tools/ are pure ----------------------------------------------
[importlinter:contract:tools-no-temporal]
name = R-DIP: tools/*.py must not import temporalio (no client, worker, or activity.defn)
type = forbidden
source_modules =
    src.plugins.chats.agent.sales.tools
forbidden_modules =
    temporalio
; Tools return decisions (DTOs). The workflow turns them into activities. ADR-001.
; Stricter than the original rule (forbids the whole package) because import-linter
; can't restrict to sub-modules of external packages — but tools have no legitimate
; reason to import temporalio in any form. Only sales (chats plugin) owns tools today.

; --- R-DIP #8 — parsers stay pure --------------------------------------------
[importlinter:contract:parsers-pure]
name = R-DIP: parsers.py must not perform I/O (httpx, requests, temporalio, litellm)
type = forbidden
source_modules =
    src.plugins.chats.agent.sales.parsers
forbidden_modules =
    httpx
    requests
    litellm
    temporalio
; parsers.py is pure: input string → dataclass. No network, no temporal coupling.
; If parsers/ ever becomes a package, switch source_modules accordingly.
