{
  "version": "7.2",
  "routing_model": {
    "SHIPPING_DETAILS": []
  },
  "screens": [
    {
      "id": "SHIPPING_DETAILS",
      "title": "Datos de envío",
      "terminal": true,
      "success": true,
      "data": {
        "order_total_cop": {
          "type": "number",
          "__example__": 17000
        },
        "items_summary": {
          "type": "string",
          "__example__": "1× Vela Cruz de Vida"
        },
        "show_cash_on_delivery": {
          "type": "boolean",
          "__example__": false
        },
        "payment_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "transfer",
              "title": "📲 Pago anticipado (Nequi)",
              "description": "Nequi o llave 3229041190."
            },
            {
              "id": "payment_link",
              "title": "🔗 Link de pago",
              "description": "Recargo adicional: 1,5% con Nequi o Bancolombia, 2,69% con otros bancos."
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Completá tus datos"
          },
          {
            "type": "TextSubheading",
            "text": "${data.items_summary}"
          },
          {
            "type": "TextInput",
            "name": "city",
            "label": "Ciudad",
            "required": true,
            "input-type": "text",
            "helper-text": "Bogotá, Medellín, Cali…"
          },
          {
            "type": "TextInput",
            "name": "neighborhood",
            "label": "Barrio",
            "required": true,
            "input-type": "text",
            "helper-text": "Ej. Chapinero, El Poblado"
          },
          {
            "type": "TextInput",
            "name": "address",
            "label": "Dirección",
            "required": true,
            "input-type": "text",
            "helper-text": "Calle, número, apto/casa"
          },
          {
            "type": "TextInput",
            "name": "phone",
            "label": "Teléfono de contacto",
            "required": true,
            "input-type": "phone",
            "helper-text": "Para coordinar la entrega"
          },
          {
            "type": "TextInput",
            "name": "receiver_name",
            "label": "Quién recibe",
            "required": true,
            "input-type": "text",
            "helper-text": "Nombre completo de quien recibe el pedido"
          },
          {
            "type": "TextInput",
            "name": "national_id",
            "label": "Cédula (opcional)",
            "required": false,
            "input-type": "number",
            "helper-text": "De quien recibe, para la guía de envío"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "payment_method",
            "label": "Método de pago",
            "required": true,
            "data-source": "${data.payment_options}"
          },
          {
            "type": "Footer",
            "label": "Confirmar datos",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "city": "${form.city}",
                "neighborhood": "${form.neighborhood}",
                "address": "${form.address}",
                "phone": "${form.phone}",
                "receiver_name": "${form.receiver_name}",
                "national_id": "${form.national_id}",
                "payment_method": "${form.payment_method}",
                "order_total_cop": "${data.order_total_cop}",
                "items_summary": "${data.items_summary}"
              }
            }
          }
        ]
      }
    }
  ]
}
