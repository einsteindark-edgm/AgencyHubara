    "BurstQuestion": {
      "additionalProperties": false,
      "description": "Una pregunta fija de la ráfaga; con `when`, solo si los hechos del\nturno coinciden (`{hecho: valor}` o `{hecho: [valores]}`).",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "noul",
            "choice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "criteria": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Criteria",
          "type": "object"
        },
        "when": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "criteria"
      ],
      "title": "BurstQuestion",
      "type": "object"
    },
